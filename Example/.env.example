# Rivium Storage Web example - copy this file to .env.local and fill it in (.env.local is git-ignored).
# Only PUBLIC values belong here: everything VITE_* ends up in the browser.
# NEVER put the server secret (rv_srv_...) in this file - it lives in the Node example's .env.

# Console > your project > API keys > public key
VITE_RIVIUM_API_KEY=rv_live_YOUR_PUBLIC_KEY

# The Node example server (sdk/nodejs/Example: npm run server). It mints user tokens with the server secret.
VITE_EXAMPLE_SERVER_URL=http://localhost:4000
# Only if the Node example server has DEMO_TOKEN set: the same value (sent as the x-demo-token header).
VITE_DEMO_TOKEN=

# The test buckets (same names as in the Node example's .env)
VITE_PUBLIC_BUCKET=example-public
VITE_PRIVATE_BUCKET=avatars

# The demo user this page signs in as (any id: the demo server mints a token for it)
VITE_DEMO_USER_ID=demo-user-1
